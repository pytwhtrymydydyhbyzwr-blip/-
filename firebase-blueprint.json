{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "fullName": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "fullName"]
    },
    "Habit": {
      "title": "Habit",
      "description": "A user's tracked habit with logs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "maxLength": 50 },
        "targetValue": { "type": "number" },
        "unit": { "type": "string", "maxLength": 50 },
        "color": { "type": "string", "maxLength": 50 },
        "icon": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "archived": { "type": "boolean" }
      },
      "required": ["id", "userId", "name", "category", "type"]
    },
    "GamificationStats": {
      "title": "GamificationStats",
      "description": "User gamification points, level and badges",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "unlockedBadgeIds": { "type": "array" },
        "totalEarlyCompletions": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "xp", "level"]
    },
    "FeedItem": {
      "title": "FeedItem",
      "description": "Social feed item for completed habits and badges",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 200 },
        "habitName": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "maxLength": 50 },
        "streakCount": { "type": "number" },
        "timestamp": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "userName", "habitName"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public directory profile for multi-user discovery",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 200 },
        "statusBio": { "type": "string", "maxLength": 300 },
        "level": { "type": "number" },
        "bestStreak": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "fullName"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "WhatsApp chat message across group/direct chats",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "chatId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderAvatar": { "type": "string", "maxLength": 200 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "text": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "chatId", "senderId", "senderName", "text"]
    },
    "StatusStory": {
      "title": "StatusStory",
      "description": "WhatsApp status story update",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userAvatar": { "type": "string", "maxLength": 200 },
        "timestamp": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "maxLength": 50 },
        "textContent": { "type": "string", "maxLength": 1000 },
        "imageUrl": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "userId", "userName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile document"
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": { "$ref": "#/entities/Habit" },
      "description": "Habit document owned by user"
    },
    "/users/{userId}/gamification/stats": {
      "schema": { "$ref": "#/entities/GamificationStats" },
      "description": "User gamification progress"
    },
    "/feed/{feedItemId}": {
      "schema": { "$ref": "#/entities/FeedItem" },
      "description": "Public community feed item"
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public profile discovery"
    },
    "/chats/{chatId}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Realtime group/direct chat messages"
    },
    "/statuses/{statusId}": {
      "schema": { "$ref": "#/entities/StatusStory" },
      "description": "WhatsApp status story updates"
    }
  }
}
